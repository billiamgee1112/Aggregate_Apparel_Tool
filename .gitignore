# Ignore virtual environment
venv/

# Ignore Node tooling (only used locally to build static/css/tailwind.css -
# the compiled output IS committed/shipped, since the cloud VPS has no Node
# install and shouldn't need one; rerun `npm run build:css` after editing
# templates, then commit the updated static/css/tailwind.css)
node_modules/

# Ignore environment variables
.env

# Ignore SQLite local databases
*.db

# Ignore scratch/output data files (not part of the actual pipeline - see
# MAINTENANCE.md; products.json is a stale one-off export, and the OceanDust
# manual_page files are scratch input meant to be deleted after each weekly
# import, not committed)
products.json
oceandust_manual_page*.json

# Ignore Python runtime files and caches
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/

# Ignore local VS Code workspace settings
.vscode/

# Ignore system artifacts
.DS_Store
Thumbs.db