{
  "name": "aggregate_apparel_tool",
  "version": "1.0.0",
  "description": "A robust, asynchronous multi-store web scraping pipeline built with Python, Playwright, and Pydantic. It extracts structured product data from various e-commerce apparel sites into a relational SQLite database while filtering out non-clothing accessories.",
